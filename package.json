{
  "name": "botlenoapp",
  "version": "1.0.0",
  "private": true,
  "description": "Production Discord queue/job management bot",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node index.js",
    "test": "node --import tsx --test tests/hours.test.ts tests/time.test.ts tests/queue.test.ts tests/permissions.test.ts tests/setup-plan.test.ts tests/cooldown.test.ts tests/send-jo.test.ts tests/logs.test.ts tests/display.test.ts tests/deploy.test.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.3",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0"
  }
}
